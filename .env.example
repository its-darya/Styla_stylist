# Retrieval modulu (C) — mühit dəyişənləri
STYLA_DB_URL=postgresql://styla_user:styla_password@localhost:5440/styla_wardrobe
STYLA_BACKEND=numpy
STYLA_BATCH_SIZE=8
STYLA_NUM_THREADS=4
STYLA_MATCH_THRESHOLD=0.75
STYLA_MODEL_ID=patrickjohncyh/fashion-clip

# Pinterest API (reference feed)
# Qeydiyyat: https://developers.pinterest.com/ → Create app
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8000/api/pinterest/callback
# İstəyə bağlı: OAuth axını keçmədən birbaşa token təyin etmək üçün
PINTEREST_ACCESS_TOKEN=
