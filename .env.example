# Retrieval modulu (C) — mühit dəyişənləri
STYLA_DB_URL=postgresql://styla:styla@localhost:5432/styla
STYLA_BACKEND=numpy
STYLA_BATCH_SIZE=8
STYLA_NUM_THREADS=4
STYLA_MATCH_THRESHOLD=0.75
STYLA_MODEL_ID=patrickjohncyh/fashion-clip

# Optional: Programmable Search Engine for real Google product pages.
# Without these keys, Styla uses DuckDuckGo shopping, then Google Shopping.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
