# --- Database ---------------------------------------------------------------
# One PostgreSQL database with the pgvector extension serves the whole app.
# Local Docker (docker compose up -d):
DATABASE_URL=postgresql://styla_user:styla_password@localhost:5440/styla_wardrobe
# Shared cloud instance (Neon etc.) — paste the pooled connection string instead:
# DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# --- Auth -------------------------------------------------------------------
# Secret used to sign login tokens. Leave empty to auto-generate one in
# data/.jwt_secret (fine for development; set it explicitly in production).
STYLA_JWT_SECRET=
STYLA_TOKEN_TTL_DAYS=7
# Built-in demo account (created on first start; owns the seeded wardrobe)
STYLA_DEMO_EMAIL=demo@styla.app
STYLA_DEMO_PASSWORD=demo1234

# --- URLs -------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- ML runtime -------------------------------------------------------------
STYLA_BATCH_SIZE=8
STYLA_NUM_THREADS=4
STYLA_MODEL_ID=patrickjohncyh/fashion-clip

# --- Virtual try-on (optional) ---------------------------------------------
# Try-on runs on free Hugging Face Spaces. Without a token every request shares
# a small anonymous GPU quota that runs out after a few try-ons; a free account
# token (https://huggingface.co/settings/tokens, read access is enough) gives a
# larger per-account allowance.
HF_TOKEN=

REPLICATE_API_TOKEN=

# --- Pinterest API (optional, reference feed) --------------------------------
# Register: https://developers.pinterest.com/ -> Create app
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8000/api/pinterest/callback
PINTEREST_ACCESS_TOKEN=
